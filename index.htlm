<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>World Workbench</title>
<!-- workbench-enc -->
<style>html,body{margin:0;background:#171a18;color:#e8ebe6;font:16px/1.4 system-ui,sans-serif}main{max-width:420px;margin:0 auto;padding:22vh 20px 20px}h1{font-size:34px;letter-spacing:.04em;text-transform:uppercase;margin:0 0 18px}input,button{font:inherit;width:100%;box-sizing:border-box;padding:14px;border:2px solid #3b423d;background:#0f1110;color:inherit;border-radius:0;margin-top:10px}button{background:#7ed36e;color:#10210d;border-color:#7ed36e;font-weight:700}small{opacity:.6;display:block;margin-top:6px}#m{color:#ff8a80;min-height:1.4em;margin-top:10px}</style></head>
<body><main id="m0"><h1>World Workbench</h1><div id="t">Enter password<small>ใส่รหัสผ่าน</small></div><form id="f" autocomplete="off"><input id="p" type="password" autocapitalize="none" autocorrect="off" placeholder="password"><button>Open · เปิด</button></form><div id="m"></div></main>
<script>
(function(){var B={"n":150000,"i":"uNYSwRjyMEtu/jgG","d":"","w":[{"s":"a5ysY+TdZU8DYV/CtRnDqA==","i":"T9JulyW05SsbUTJE","k":"cd46yV9NBV9IThMpzSExULFqRgrsMg6btGBUOIWgzWhLnmTRrUXy2Z3i5I1rVDXc"},{"s":"M53fBF9sZO7BZgaLPk74Zg==","i":"NHPeLcOFQQ/TbMfE","k":"5heBfz+yx2W6yh5QuIf9NQvc3exai0KDxeJhG5HIBGB6SYvxLsmtbxZ+TTaVxi08"}]};
function b(x){var s=atob(x),u=new Uint8Array(s.length);for(var i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u}
async function open(pw){var enc=new TextEncoder(),k=await crypto.subtle.importKey('raw',enc.encode(pw),'PBKDF2',false,['deriveKey']);
for(var j=0;j<B.w.length;j++){var w=B.w[j];try{var key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b(w.s),iterations:B.n,hash:'SHA-256'},k,{name:'AES-GCM',length:256},false,['decrypt']);
var raw=await crypto.subtle.decrypt({name:'AES-GCM',iv:b(w.i)},key,b(w.k));
var ck=await crypto.subtle.importKey('raw',raw,'AES-GCM',false,['decrypt']);
var out=await crypto.subtle.decrypt({name:'AES-GCM',iv:b(B.i)},ck,b(B.d));return new TextDecoder().decode(out)}catch(e){}}
throw new Error('bad')}
async function go(pw,remember){var m=document.getElementById('m');m.textContent='…';
try{var h=await open(pw);if(remember){try{localStorage.setItem('wbk',pw)}catch(e){}}document.open();document.write(h);document.close()}
catch(e){m.textContent='Wrong password · รหัสผ่านไม่ถูก';try{localStorage.removeItem('wbk')}catch(_){}}}
var hp=decodeURIComponent((location.hash||'').replace(/^#/,''));
var sp='';try{sp=localStorage.getItem('wbk')||''}catch(e){}
if(hp){go(hp,false)}else if(sp){go(sp,false)}
document.getElementById('f').addEventListener('submit',function(e){e.preventDefault();go(document.getElementById('p').value,true)});
})();
</script></body></html>
